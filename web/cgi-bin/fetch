#!/bin/sh
# CGI script (BusyBox httpd): downloads a page or image for the web app, which
# can't fetch other sites itself (CORS). ADR-0033.
#
#   GET /cgi-bin/fetch?url=<percent-encoded Address>
#
# Answers 200 with the upstream Content-Type and body, or a refusal: a status
# and a one-line text/plain reason.
#   400 not an http(s) Address       403 host is private, loopback or LAN
#   413 over the size cap            415 neither HTML nor an image
#   502 upstream failed or redirects too often     504 over the time cap
#
# `wget` follows redirects without a way to stop it, so each hop is one raw
# HTTP/1.0 request over `nc` (and `ssl_client` for https), sent to the IP that
# passed the check: the host can't resolve to another one afterwards.
# Like `wget`, this does not validate certificates.
#
# Tests only: PKM_FETCH_ALLOW=<ip> lets that one address pass the check;
# PKM_FETCH_MAX_BYTES and PKM_FETCH_SECONDS override the caps.

MAX_BYTES=${PKM_FETCH_MAX_BYTES:-10485760}
SECONDS_CAP=${PKM_FETCH_SECONDS:-20}
MAX_REDIRECTS=5

# Prints the refusal (status, reason) and stops.
refuse() {
	printf 'Status: %s\r\nContent-Type: text/plain\r\nX-Content-Type-Options: nosniff\r\n\r\n%s\n' "$1" "$2"
	exit 0
}

# The time cap: run the work as a child, so a timeout can still answer.
if [ -z "$PKM_FETCH_INNER" ]; then
	PKM_FETCH_INNER=1 timeout "$SECONDS_CAP" sh "$0"
	case $? in 124 | 143) refuse 504 "took longer than ${SECONDS_CAP}s" ;; esac
	exit 0
fi

work=$(mktemp -d) || refuse 502 "no temporary space"
pids=
cleanup() {
	[ -n "$pids" ] && kill $pids 2>/dev/null
	rm -rf "$work"
}
trap cleanup EXIT
trap 'exit 124' TERM

# Decodes %XX; backslashes are escaped first, as printf %b reads them.
decode() {
	printf '%b' "$(printf %s "$1" | sed 's/\\/\\\\/g; s/%\(..\)/\\x\1/g')"
}

# Whether $1 is an IPv4 address that may be fetched from (no private, loopback,
# link-local, CGNAT, benchmarking, multicast or reserved range).
public4() {
	old=$IFS
	IFS=.
	set -- $1
	IFS=$old
	case $1 in 0 | 10 | 127 | 22[4-9] | 2[3-5][0-9]) return 1 ;; esac
	case $1.$2 in 100.6[4-9] | 100.[7-9][0-9] | 100.1[01][0-9] | 100.12[0-7]) return 1 ;; esac
	case $1.$2 in 169.254 | 172.1[6-9] | 172.2[0-9] | 172.3[01] | 192.168 | 198.18 | 198.19) return 1 ;; esac
	[ "$1.$2.$3" = 192.0.0 ] && return 1
	return 0
}

# Whether $1 is a global unicast IPv6 address (2000::/3), less the ranges that
# embed an IPv4 address (6to4, Teredo) or are for documentation. Everything
# else (::1, fe80::, fc00::, ff00::, ::ffff:a.b.c.d) is refused.
public6() {
	case $1 in
	2002:* | 2001:0:* | 2001:db8:* | 2001:0db8:*) return 1 ;;
	[23]???:*) return 0 ;;
	esac
	return 1
}

# Whether $1 may be connected to: a public address, or PKM_FETCH_ALLOW.
allowed() {
	[ "$1" = "${PKM_FETCH_ALLOW:-}" ] && return 0
	case $1 in
	*:*) public6 "$1" ;;
	*) public4 "$1" ;;
	esac
}

# Prints the addresses of $1, IPv4 first.
addresses() {
	case $1 in
	*:*) echo "$1" ;;
	*[!0-9.]*)
		nslookup "$1" 2>/dev/null | awk '
			/^Name:/ { found = 1 }
			found && /^Address/ { if ($NF ~ /:/) v6 = v6 $NF "\n"; else print $NF }
			END { printf "%s", v6 }'
		;;
	*) echo "$1" ;;
	esac
}

# Splits the Address $1 into scheme, host, port, authority and target (path
# and query, never empty).
parse() {
	case $1 in
	http://*) scheme=http; port=80; rest=${1#http://} ;;
	https://*) scheme=https; port=443; rest=${1#https://} ;;
	*) refuse 400 "only http and https Addresses" ;;
	esac
	authority=${rest%%[/?#]*}
	target=${rest#"$authority"}
	target=${target%%#*}
	case $target in /*) ;; *) target=/$target ;; esac
	case $authority in
	*@*) refuse 400 "Addresses with a user name are refused" ;;
	\[*\]*)
		host=${authority%%]*}
		host=${host#[}
		rest=${authority#*]}
		[ -n "$rest" ] && port=${rest#:}
		;;
	*:*)
		host=${authority%%:*}
		port=${authority#*:}
		;;
	*) host=$authority ;;
	esac
	[ -n "$host" ] || refuse 400 "no host"
	# Digits and dots must be a canonical dotted quad: `nc` would read 010.0.0.1
	# as octal and 2130706433 as 127.0.0.1.
	case $host in *[!0-9.]*) ;; *)
		printf %s "$host" | grep -Eq '^(0|[1-9][0-9]{0,2})(\.(0|[1-9][0-9]{0,2})){3}$' \
			|| refuse 400 "not a valid IP address"
		;;
	esac
	case $port in "" | *[!0-9]*) refuse 400 "bad port" ;; esac
}

# Prints $1, a Location, as an absolute Address, relative to the current one
# (scheme, authority, target).
absolute() {
	dir=${target%%\?*}
	case $1 in
	[a-zA-Z]*:*) echo "$1" ;;
	//*) echo "$scheme:$1" ;;
	/*) echo "$scheme://$authority$1" ;;
	\?*) echo "$scheme://$authority$dir$1" ;;
	*) echo "$scheme://$authority${dir%/*}/$1" ;;
	esac
}

# Requests the current Address once from $1, the checked IP; leaves the raw
# response in $work/resp, at most MAX_BYTES of it.
request() {
	hostport=$host
	case $host in *:*) hostport="[$host]" ;; esac
	[ "$port" = "$([ $scheme = http ] && echo 80 || echo 443)" ] || hostport=$hostport:$port
	rm -f "$work/in" "$work/resp"
	mkfifo "$work/in"
	: >"$work/resp"
	# The writer holds the request pipe open until the response is in.
	{
		printf 'GET %s HTTP/1.0\r\nHost: %s\r\nUser-Agent: pkm\r\nAccept: text/html, image/*\r\nConnection: close\r\n\r\n' "$target" "$hostport"
		sleep "$SECONDS_CAP"
	} >"$work/in" 2>/dev/null &
	writer=$!
	pids=$writer
	# nc hands its socket to the command as stdin; the plain-text side goes
	# through the pipe and the file. ulimit -f counts 512-byte blocks and stops
	# a larger download.
	if [ $scheme = https ]; then
		relay="exec 3<&0 0<'$work/in' 1>'$work/resp'; exec ssl_client -s3 -n '$host'"
	else
		relay="exec 3<&0; cat <'$work/in' >&3 & exec cat <&3 >'$work/resp'"
	fi
	(
		ulimit -c 0
		ulimit -f $((MAX_BYTES / 512 + 8))
		nc -n "$1" "$port" -e sh -c "$relay"
	) 2>/dev/null
	kill $writer 2>/dev/null
	pids=
	[ -s "$work/resp" ] || refuse 502 "could not download the Address"
}

# Reads the status line and headers of $work/resp into status, ctype, location
# and chunked, and the (de-chunked) body into $work/body.
read_response() {
	status= ctype= location= chunked=
	exec 4<"$work/resp"
	cr=$(printf '\r')
	read -r line <&4
	line=${line%"$cr"}
	status=$(printf %s "$line" | awk '{ print $2 }')
	while read -r line <&4; do
		line=${line%"$cr"}
		[ -n "$line" ] || break
		name=$(printf %s "${line%%:*}" | tr 'A-Z' 'a-z')
		value=${line#*:}
		value=${value# }
		case $name in
		content-type) ctype=$value ;;
		location) location=$value ;;
		transfer-encoding) chunked=$value ;;
		esac
	done
	case $chunked in
	*[Cc]hunked*) dechunk <&4 >"$work/body" || refuse 502 "the site sent a broken response" ;;
	*) cat <&4 >"$work/body" ;;
	esac
	exec 4<&-
}

# Copies a chunked body from stdin to stdout, de-chunked (some sites chunk
# even HTTP/1.0 responses); fails on a broken chunk size. `head -c` reads
# exactly the bytes asked for.
dechunk() {
	while read -r size; do
		size=${size%"$cr"}
		size=${size%%;*}
		case $size in "" | *[!0-9a-fA-F]*) return 1 ;; esac
		size=$((0x$size))
		[ $size -gt 0 ] || break
		head -c $size
		read -r _
	done
}

# An Address is printable ASCII only, so it can't break the request line.
valid() {
	case $1 in "" | *[![:graph:]]*) return 1 ;; esac
}

query=${QUERY_STRING#url=}
[ "$query" != "$QUERY_STRING" ] || refuse 400 "missing url"
url=$(decode "${query%%&*}")

redirects=0
while :; do
	valid "$url" || refuse 400 "not a valid Address"
	parse "$url"
	ip=
	for candidate in $(addresses "$host"); do
		allowed "$candidate" || refuse 403 "$host is a private or local address"
		[ -n "$ip" ] || ip=$candidate
	done
	[ -n "$ip" ] || refuse 502 "could not find $host"
	request "$ip"
	[ "$(wc -c <"$work/resp")" -lt "$MAX_BYTES" ] || refuse 413 "larger than $((MAX_BYTES / 1048576)) MB"
	read_response
	case $status in
	200) break ;;
	301 | 302 | 303 | 307 | 308)
		redirects=$((redirects + 1))
		[ $redirects -le $MAX_REDIRECTS ] || refuse 502 "too many redirects"
		valid "$location" || refuse 502 "redirect without a valid Location"
		url=$(absolute "$location")
		;;
	*) refuse 502 "the site answered ${status:-with something else than HTTP}" ;;
	esac
done

type=$(printf %s "${ctype%%;*}" | tr 'A-Z' 'a-z')
case $type in
text/html | application/xhtml+xml | image/*) ;;
*) refuse 415 "only HTML and images, not ${type:-an unknown type}" ;;
esac

# The page is served from the web app's origin: the sandbox keeps its scripts
# from running there, if it is ever opened as a document.
printf 'Status: 200\r\nContent-Type: %s\r\nContent-Length: %s\r\nContent-Security-Policy: sandbox\r\nX-Content-Type-Options: nosniff\r\n\r\n' \
	"$ctype" "$(wc -c <"$work/body")"
cat "$work/body"
